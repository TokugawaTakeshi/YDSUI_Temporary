{
  "name": "@yamato-daiwa/serial-unique-identifiers",
  "version": "0.0.0",
  "description": "Generates IDs respecting possible collisions",
  "keywords": [
    "id",
    "nanoid"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./Distributable/cjs/index.js",
  "module": "./Distributable/esm/index.js",
  "types": "./Distributable/esm/index.d.ts",
  "sideEffects": false,
  "files": [
    "Distributable"
  ],
  "dependencies": {
    "@yamato-daiwa/es-extensions": "1.9.3",
    "fundamental-constants": "0.9.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@yamato-daiwa/style_guides": "0.14.7",
    "rimraf": "6.1.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "scripts": {
    "Check Types": "tsc -p tsconfig-cjs.json --noEmit",
    "Lint": "eslint",
    "Run Tests": "node --require tsx/cjs --test \"Tests/**/*.test.ts\" --coverage",
    "Rebuild Distributable Without Preliminary Cleaning": "tsc -p tsconfig-cjs.json && tsc -p tsconfig-esm.json",
    "Rebuild Distributable": "rimraf Distributable && tsc -p tsconfig-cjs.json && tsc -p tsconfig-esm.json",
    "Rebuild Distributable and Realize Alpha": "npm run \"Rebuild Distributable\" && npm publish --tag alpha",
    "Rebuild Distributable and Realize RC": "npm run \"Rebuild Distributable\" && npm publish --tag rc",
    "Print Project Structure": "wsl tree -I \".git|.idea|node_modules|Distributable\" || tree -I \".git|.idea|node_modules|Distributable\""
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
